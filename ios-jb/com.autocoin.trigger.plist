<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.autocoin.trigger</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/python3</string>
		<string>/var/mobile/shopee-autocoin/ios-jb/serve.py</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/mobile/shopee-autocoin/logs/serve.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/shopee-autocoin/logs/serve.log</string>
</dict>
</plist>